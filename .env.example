# Configuration Supabase (Production / Staging)
# Obtenez ces valeurs depuis votre tableau de bord Supabase : https://supabase.com/dashboard/project/<votre-id>/settings/api
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique_ici
VITE_APP_ID=app-edudesk-tcf

# ==============================================================================
# VARIABLES CÔTÉ SERVEUR (SUPABASE EDGE FUNCTIONS) — NE JAMAIS EXPOSER AU CLIENT
# À configurer via le Supabase CLI ou Dashboard > Settings > Edge Functions Secrets :
#   supabase secrets set PAWAPAY_API_KEY=... PAYSTACK_SECRET_KEY=...
# ==============================================================================
# PAWAPAY_API_KEY=votre_cle_api_pawapay # Clé secrète marchand PawaPay
# PAWAPAY_BASE_URL=https://api.pawapay.io # ou https://api.sandbox.pawapay.io
# PAYSTACK_SECRET_KEY=sk_live_...
# ANTHROPIC_API_KEY=sk-ant-api03-...  # Notation EE & EO
# GEMINI_API_KEY=AIzaSy...            # Transcription audio EO
# ANTHROPIC_MODEL=claude-sonnet-5-5   # Optionnel (valeur par défaut)
# GEMINI_MODEL=gemini-3.6-flash       # Optionnel (valeur par défaut)

